---
import Layout from "../layouts/Layout.astro";

import External from "../assets/external.svg";

import { Icon } from "astro-icon/components";

const title = "签名";
---

<Layout title={title}>
  <h2>{title}</h2>
  <p>密钥算法：ssh-ed25519</p>
  <p>
    SHA-256 指纹：<code>4LlkGj+uV8LjbOYgvmWoGna8dUtnSepaClrVkjEZWfU</code>
  </p>
  <p>
    公钥数据：
    <code>
      AAAAC3NzaC1lZDI1NTE5AAAAIEECFxVltE4iYpyD0nGM0Bz4mrJgnC5J7At2Hnoz/tk2
    </code>
  </p>
  <p>SSH Key 私钥：</p>

  <p>
    <code>-----BEGIN OPENSSH PRIVATE KEY-----</code>
  </p>

  <p>
    <code>You cannot read it, BECAUSE I KNOW WHAT YOU WANT.</code>
  </p>
  <p>
    <code>LOL :)</code>
  </p>

  <p>
    <code>-----END OPENSSH PRIVATE KEY-----</code>
  </p>

  <p>
    Randomart image:{" "}
    <a
      href="javascript:void(0)"
      data-bs-toggle="modal"
      data-bs-target="#randomart-image-Modal"
    >
      <u>点此查看</u>
    </a>
  </p>

  <div class="alert alert-warning" role="alert">
    <b>
      <Icon name="mdi:email-remove" /> 拒收对应电子邮件
    </b>
    <hr />
    <p>
      除{" "}
      <a href="mailto:hi@mcenahle.page" target="_blank">
        <u>hi@mcenahle.page</u> <External />
      </a>{" "}
      之外，拒收所有自然人的电子邮件。如有骚扰的，列入全局（包含{" "}
      <code>hi@mcenahle.page</code>）黑名单。
    </p>
  </div>

  <p>
    Comment:{" "}
    <a href="mailto:hi@mcenahle.page" target="_blank">
      <u>hi@mcenahle.page</u> <External />
    </a>{" "}
    |{" "}
    <a href="mailto:code@mcenahle.dev" target="_blank">
      <u>code@mcenahle.dev</u> <External />
    </a>{" "}
    |{" "}
    <a href="mailto:hi@mcenahle.care" target="_blank">
      <u>hi@mcenahle.care</u> <External />
    </a>{" "}
    |{" "}
    <a href="mailto:webmaster@mcenahle.edu.pl" target="_blank">
      <u>webmaster@mcenahle.edu.pl</u> <External />
    </a>
  </p>

  <p style="text-align: right;">Last updated: Nov 18, 2026.</p>

  <div
    class="modal fade"
    id="randomart-image-Modal"
    tabindex="-1"
    aria-labelledby="randomart-image-Label"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="randomart-image-Label">
            我的 Randomart image
          </h1>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body text-center">
          <p>
            <code>+--[ED25519 256]--+</code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.o...&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.o&nbsp;&nbsp;&nbsp;.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;+.&nbsp;&nbsp;&nbsp;&nbsp;E&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.=o&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;&nbsp;&nbsp;.==.S.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |&nbsp;&nbsp;...*=.+&nbsp;.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |..o==++O&nbsp;+&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |.++++o%.+&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>
              |+.oo.O+o &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;|
            </code>
          </p>
          <p>
            <code>+----[SHA256]-----+</code>
          </p>
        </div>
        <div class="modal-footer">
          <a
            href="/randomart-image.txt"
            target="_blank"
            type="button"
            class="btn btn-primary"
          >
            查看 txt 版 Randomart image <Icon name="mdi:arrow-top-right" />
          </a>
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            关闭
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .modal-body {
    p {
      margin-bottom: 0rem;
    }
  }
</style>
